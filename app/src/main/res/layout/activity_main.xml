    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_nav" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@color/white" app:itemIconTint="@color/nav_item" app:itemTextColor="@color/nav_item" app:itemActiveIndicatorStyle="@style/Widget.Material3.BottomNavigationView.ActiveIndicator" app:labelVisibilityMode="labeled" app:menu="@menu/patient_nav" android:elevation="8dp" app:itemIconSize="22dp" app:paddingBottomSystemWindowInsets="false" />
</LinearLayout>