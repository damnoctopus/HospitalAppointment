<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
    <com.google.android.material.card.MaterialCardView style="@style/Card" app:cardBackgroundColor="@color/teal_light">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="80dp" android:layout_height="80dp" android:padding="24dp" android:background="@drawable/soft_teal" android:src="@drawable/ic_profile" android:contentDescription="@string/screen_profile_1" android:layout_gravity="center_horizontal" />
            <TextView style="@style/Section" android:text="@string/screen_profile_2" android:layout_gravity="center_horizontal" android:gravity="center" android:layout_marginTop="10dp" />
            <TextView style="@style/Title" android:text="@string/screen_profile_3" android:id="@+id/profile_name" android:layout_gravity="center_horizontal" android:gravity="center" android:layout_marginTop="10dp" />
            <TextView style="@style/Body" android:text="@string/screen_profile_4" android:id="@+id/profile_email" android:layout_gravity="center_horizontal" android:gravity="center" android:layout_marginTop="10dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView style="@style/Section" android:text="@string/screen_profile_5" />
    <TextView style="@style/Body" android:text="@string/screen_profile_6" />
    <com.google.android.material.button.MaterialButton android:id="@+id/profile_appointments" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_profile_7" style="@style/CareOutlineButton" android:minHeight="52dp" app:icon="@drawable/ic_calendar" app:iconGravity="textStart" app:iconPadding="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_profile_8" style="@style/CareOutlineButton" android:minHeight="52dp" />
</LinearLayout>