<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
    <TextView style="@style/Title" android:text="@string/screen_availability_1" />
    <TextView style="@style/Body" android:text="@string/screen_availability_2" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
    <Spinner android:id="@+id/availability_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:background="@drawable/surface_outline" android:contentDescription="@string/screen_availability_3" android:minHeight="60dp" android:padding="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/availability_date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_availability_4" style="@style/CareOutlineButton" android:minHeight="52dp" app:icon="@drawable/ic_calendar" app:iconGravity="textStart" app:iconPadding="12dp" />
    <TextView style="@style/Section" android:text="@string/screen_availability_5" />
    <TextView style="@style/Body" android:text="@string/screen_availability_6" />
    <com.google.android.material.chip.ChipGroup android:id="@+id/availability_slots" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp" />
    <TextView style="@style/Body" android:text="@string/screen_availability_7" android:id="@+id/availability_empty" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add_slot" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_availability_8" app:icon="@drawable/ic_clock" app:iconGravity="textStart" app:iconPadding="12dp" />
</LinearLayout>