<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
    <com.google.android.material.card.MaterialCardView style="@style/Card" app:cardBackgroundColor="@color/teal_light">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <ImageView android:id="@+id/detail_avatar" android:layout_width="120dp" android:layout_height="140dp" android:layout_gravity="center_horizontal" android:contentDescription="@string/screen_detail_1" />
            <TextView style="@style/Title" android:text="@string/screen_detail_2" android:id="@+id/detail_name" android:layout_gravity="center_horizontal" android:gravity="center" android:layout_marginTop="10dp" android:textSize="24sp" />
            <TextView style="@style/Body" android:text="@string/screen_detail_3" android:id="@+id/detail_specialty" android:layout_gravity="center_horizontal" android:gravity="center" android:layout_marginTop="10dp" android:textColor="@color/teal_dark" android:fontFamily="sans-serif-medium" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView style="@style/Section" android:text="@string/screen_detail_4" />
    <TextView style="@style/Body" android:text="@string/screen_detail_5" android:id="@+id/detail_about" />
    <TextView style="@style/Section" android:text="@string/available_consultation_times" />
    <TextView style="@style/Body" android:text="@string/screen_detail_7" android:id="@+id/detail_hours" android:background="@drawable/surface_outline" android:padding="20dp" />
    <TextView style="@style/Body" android:text="@string/screen_detail_8" />
    <com.google.android.material.button.MaterialButton android:id="@+id/book_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_detail_9" app:icon="@drawable/ic_calendar" app:iconGravity="textStart" app:iconPadding="12dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/edit_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_detail_10" style="@style/CareOutlineButton" android:minHeight="52dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/remove_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_detail_11" style="@style/CareOutlineButton" android:minHeight="52dp" />
</LinearLayout>