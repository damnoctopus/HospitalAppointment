<?xml version='1.0' encoding='utf-8'?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="0dp">
    <TextView style="@style/Title" android:text="@string/screen_doctors_1" android:id="@+id/list_title" />
    <TextView style="@style/Body" android:text="@string/screen_doctors_2" android:id="@+id/list_subtitle" android:layout_marginTop="10dp" android:layout_marginBottom="8dp" />
    <com.google.android.material.textfield.TextInputLayout android:id="@+id/doctor_search_box" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:hint="@string/screen_doctors_3">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/doctor_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:maxLines="1" android:singleLine="true" android:minHeight="56dp" android:textSize="16sp" android:paddingTop="16dp" android:paddingBottom="16dp" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.chip.ChipGroup android:id="@+id/filter_chips" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="8dp" android:layout_marginTop="8dp" android:layout_marginBottom="8dp" app:chipSpacingVertical="4dp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/add_doctor" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/screen_doctors_4" />
    <LinearLayout android:id="@+id/doctor_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="16dp" />
</LinearLayout>